[Unit]
Description=Aura Hub (Spring Boot)
After=network.target mysql.service

[Service]
User=aurahub
WorkingDirectory=/opt/aurahub
EnvironmentFile=/opt/aurahub/aurahub.env
ExecStart=/usr/bin/java -jar /opt/aurahub/aurahub.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
